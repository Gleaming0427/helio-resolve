NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Number of trusted proxies in front of the API (1 behind the AWS ALB). Leave empty locally.
TRUST_PROXY_HOPS=

# Local POSGRESQL (docker compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=helio
DB_PASSWORD=helio
DB_NAME=helio
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# AWS / Bedrock
AWS_REGION=eu-west-3
BEDROCK_MODEL_ID=eu.amazon.nova-pro-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Store credentials (Shopify tokens) are encrypted before storage: KMS in AWS
# (SECRET_KMS_KEY_ID, set by CDK), a local key in development only.
# Generate one with: openssl rand -base64 32
LOCAL_SECRET_KEY=

# Local development without Cognito (API and frontend must agree). The API ignores it when
# NODE_ENV=production. To test Cognito locally, set AUTH_MODE=cognito and VITE_AUTH_MODE=cognito.
AUTH_MODE=dev
COGNITO_USER_POOL_ID=eu-west-3_example
COGNITO_CLIENT_ID=exampleclientid

DEV_TENANT_ID=ten_DEMO123
DEV_USER_ID=usr_DEMO123
DEV_ROLES=support_manager,tenant_admin

# Frontend
VITE_API_URL=http://localhost:3000
VITE_AUTH_MODE=dev
VITE_COGNITO_CLIENT_ID=${COGNITO_CLIENT_ID}
VITE_COGNITO_AUTHORITY=https://cognito-idp.eu-west-3.amazonaws.com/${COGNITO_USER_POOL_ID}
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
