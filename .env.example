NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Local POSGRESQL (docker compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=helio
DB_PASSWORD=helio
DB_NAME=helio
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# AWS / Bedrock
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.amazon.nova.pro-v1:0
BEDROCK_EMBED_MODEL_ID=eu.amazon.titan-embeded-text-v2:0
KNOWLEDGE_BUCKET=helio-local-knowledge
INGEST_QUEUE_URL=https://sqs.eu-west-3.amazonaws.com/123456789012/helio-ingest

# Production auth - Cognito
AUTH_MODE=cognito
COGNITO_USER_POOL_ID=eu-west-3_example
COGNITO_CLIENT_ID=exampleclientid

# Local learning mode only. Never set AUTH_MODE=dev in production
DEV_TENANT_ID=ten_DEMO123
DEV_USER_ID=usr_DEMO123
DEV_ROLES=support_manager,tenant_admin

# Frontend
VITE_API_URL=http://localhost:3000
VITE_AUTH_MODE=dev
VITE_COGNITO_AUTHORITY=https://cognito-idp.eu-west-3.amazonaws.com/${COGNITO_USER_POOL_ID}
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
